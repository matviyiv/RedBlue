#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# bz-android — Android helper inside the blue-zone sandbox.
#
#   bz-android connect            connect adb to the emulator on the host (via
#                                 adb-relay) and reverse Metro's port onto it
#   bz-android prepare [dir]      fill in what the blue zone strips and a debug
#                                 build needs (debug keystore, placeholder
#                                 google-services.json) — never overwrites
#   bz-android build [dir]        prepare + ./gradlew assembleDebug
#   bz-android run [dir]          connect + prepare + Metro + install & launch
#   bz-android screenshot [file]  save the emulator screen as PNG
#   bz-android logs [lines]       recent logcat: errors + ReactNativeJS
#   bz-android status             toolchain, relay and device summary
#
# [dir] is the React Native project root (default: /workspace). Files this adds
# match red-zone rules, so sync-back.sh never copies them into your repo.
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

ADB_TARGET="${BLUE_ZONE_ADB_TARGET:-adb-relay:5555}"
METRO_PORT="${RCT_METRO_PORT:-8081}"
DEBUG_KEYSTORE=/opt/android-debug/debug.keystore

say()  { printf '\033[0;36m[bz-android]\033[0m %s\n' "$*"; }
warn() { printf '\033[0;33m[bz-android]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[0;31m[bz-android]\033[0m %s\n' "$*" >&2; exit 1; }

project_dir() {
  local d="${1:-/workspace}"
  [ -d "$d/android" ] || die "no android/ folder in $d — pass the React Native project root."
  printf '%s' "$d"
}

# ── connect ──────────────────────────────────────────────────────────────────
cmd_connect() {
  adb start-server >/dev/null 2>&1 || true
  if adb devices | awk 'NR>1 && $2=="device"' | grep -q "^$ADB_TARGET"; then
    say "already connected to $ADB_TARGET"
  else
    say "connecting to $ADB_TARGET ..."
    local out
    out="$(adb connect "$ADB_TARGET" 2>&1 || true)"
    case "$out" in
      *"connected to"*) ;;
      *)
        die "adb could not reach the emulator ($out).
  • Is the emulator running on the host?   ./ai-scripts/android-emulator.sh start
  • Is BLUE_ZONE_ANDROID_ADB_PORT the emulator's adb port (console port + 1)?
  • Is adb-relay up?                       docker compose ps adb-relay" ;;
    esac
  fi
  # 'unauthorized' means the emulator's adbd wants RSA approval; accept the
  # prompt on the emulator screen once (the key persists in claude-home).
  timeout 60 adb -s "$ADB_TARGET" wait-for-device \
    || die "emulator did not come online within 60s (check the emulator window for an authorization prompt)."
  local boot=""
  for _ in $(seq 1 90); do
    boot="$(adb -s "$ADB_TARGET" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')"
    [ "$boot" = "1" ] && break
    sleep 2
  done
  [ "$boot" = "1" ] || die "emulator is connected but has not finished booting."
  # Metro runs in THIS container. adb reverse is served by our own adb server,
  # so the app's request to localhost:8081 on the device lands here — no host
  # port, no published port.
  adb -s "$ADB_TARGET" reverse "tcp:$METRO_PORT" "tcp:$METRO_PORT" >/dev/null
  say "device ready: $(adb -s "$ADB_TARGET" shell getprop ro.product.model | tr -d '\r'), \
Android $(adb -s "$ADB_TARGET" shell getprop ro.build.version.release | tr -d '\r'), \
ABI $(adb -s "$ADB_TARGET" shell getprop ro.product.cpu.abi | tr -d '\r'); Metro port $METRO_PORT reversed."
}

# ── prepare ──────────────────────────────────────────────────────────────────
# Placeholder google-services.json — just enough for the Google Services Gradle
# plugin to configure a debug build. Firebase calls at runtime will fail; that
# is expected in the blue zone (the real file is red zone).
write_placeholder_google_services() {
  local file="$1"; shift
  local clients="" pkg
  for pkg in "$@"; do
    [ -n "$clients" ] && clients="$clients,"
    clients="$clients
    {
      \"client_info\": {
        \"mobilesdk_app_id\": \"1:000000000000:android:0000000000000000\",
        \"android_client_info\": { \"package_name\": \"$pkg\" }
      },
      \"oauth_client\": [],
      \"api_key\": [ { \"current_key\": \"blue-zone-placeholder-not-a-real-key\" } ],
      \"services\": { \"appinvite_service\": { \"other_platform_oauth_client\": [] } }
    }"
  done
  cat > "$file" <<JSON
{
  "_comment": "PLACEHOLDER generated by bz-android in the blue-zone sandbox. Not a real Firebase project.",
  "project_info": {
    "project_number": "000000000000",
    "project_id": "blue-zone-placeholder",
    "storage_bucket": "blue-zone-placeholder.appspot.com"
  },
  "client": [$clients
  ],
  "configuration_version": "1"
}
JSON
}

cmd_prepare() {
  local root app gradle
  root="$(project_dir "${1:-}")"
  app="$root/android/app"
  gradle="$(ls "$app"/build.gradle "$app"/build.gradle.kts 2>/dev/null | head -1 || true)"
  [ -n "$gradle" ] || die "no android/app/build.gradle(.kts) in $root"

  # Debug keystore — the template signs debug builds with app/debug.keystore.
  if grep -q "debug.keystore" "$gradle" && [ ! -f "$app/debug.keystore" ]; then
    cp "$DEBUG_KEYSTORE" "$app/debug.keystore"
    say "added throwaway android/app/debug.keystore (red zone — never synced back)"
  fi

  # Placeholder google-services.json, only when the plugin is applied.
  if grep -Eq "com\.google\.gms\.google-services" "$gradle" \
     && [ ! -f "$app/google-services.json" ] \
     && [ ! -f "$app/src/debug/google-services.json" ]; then
    local app_id suffixes pkgs=() s
    app_id="$(grep -Eo 'applicationId[[:space:]=]+["'\''][^"'\'']+' "$gradle" | head -1 | grep -Eo '[^"'\'']+$' || true)"
    [ -n "$app_id" ] || app_id="$(grep -Eo 'namespace[[:space:]=]+["'\''][^"'\'']+' "$gradle" | head -1 | grep -Eo '[^"'\'']+$' || true)"
    if [ -z "$app_id" ]; then
      warn "google-services plugin applied but no applicationId found; skipped the placeholder."
    else
      pkgs+=("$app_id")
      suffixes="$(grep -Eo 'applicationIdSuffix[[:space:]=]+["'\''][^"'\'']+' "$gradle" | grep -Eo '[^"'\'']+$' || true)"
      for s in $suffixes; do pkgs+=("$app_id$s"); done
      write_placeholder_google_services "$app/google-services.json" "${pkgs[@]}"
      say "added placeholder android/app/google-services.json for: ${pkgs[*]} (red zone — never synced back)"
    fi
  fi

  if [ ! -x "$root/android/gradlew" ]; then
    if [ -f "$root/android/gradlew" ]; then chmod +x "$root/android/gradlew"
    else warn "android/gradlew is missing — is the Gradle wrapper in the blue zone?"; fi
  fi
}

# ── build ────────────────────────────────────────────────────────────────────
cmd_build() {
  local root
  root="$(project_dir "${1:-}")"
  cmd_prepare "$root"
  [ -d "$root/node_modules/react-native" ] || die "node_modules is not installed — run yarn/npm install in $root first."
  say "assembleDebug (ABIs: ${ORG_GRADLE_PROJECT_reactNativeArchitectures:-all})"
  (cd "$root/android" && ./gradlew assembleDebug --console=plain)
  say "APK(s):"
  find "$root/android/app/build/outputs/apk" -name '*.apk' -printf '  %p (%s bytes)\n' 2>/dev/null || true
}

# ── run ──────────────────────────────────────────────────────────────────────
metro_running() {
  curl -fs --noproxy '*' "http://localhost:$METRO_PORT/status" 2>/dev/null | grep -q "packager-status:running"
}

cmd_run() {
  local root
  root="$(project_dir "${1:-}")"
  cmd_connect
  cmd_prepare "$root"
  [ -d "$root/node_modules/react-native" ] || die "node_modules is not installed — run yarn/npm install in $root first."
  if metro_running; then
    say "Metro already running on :$METRO_PORT"
  else
    say "starting Metro in the background (log: /tmp/metro.log)"
    (cd "$root" && nohup npx react-native start --port "$METRO_PORT" >/tmp/metro.log 2>&1 &)
    for _ in $(seq 1 60); do metro_running && break; sleep 1; done
    metro_running || die "Metro did not start — see /tmp/metro.log"
  fi
  say "building, installing and launching on $ADB_TARGET ..."
  (cd "$root" && ANDROID_SERIAL="$ADB_TARGET" npx react-native run-android \
      --no-packager --active-arch-only --port "$METRO_PORT")
  say "launched. 'bz-android screenshot' to see it, 'bz-android logs' for errors."
}

# ── screenshot / logs / status ───────────────────────────────────────────────
cmd_screenshot() {
  local out="${1:-/tmp/emulator-screen.png}"
  adb -s "$ADB_TARGET" exec-out screencap -p > "$out"
  say "saved $out"
}

cmd_logs() {
  local n="${1:-200}"
  adb -s "$ADB_TARGET" logcat -d -v brief '*:E' 'ReactNativeJS:V' 'ReactNative:W' | tail -n "$n"
}

cmd_status() {
  say "java:   $(java -version 2>&1 | grep -m1 version)"
  say "sdk:    $ANDROID_HOME ($(ls "$ANDROID_HOME/platforms" 2>/dev/null | tr '\n' ' '))"
  say "ndk:    $(ls "$ANDROID_HOME/ndk" 2>/dev/null | tr '\n' ' ')"
  say "abis:   ${ORG_GRADLE_PROJECT_reactNativeArchitectures:-all}"
  say "target: $ADB_TARGET"
  adb devices -l
}

case "${1:-}" in
  connect)    shift; cmd_connect "$@" ;;
  prepare)    shift; cmd_prepare "$@" ;;
  build)      shift; cmd_build "$@" ;;
  run)        shift; cmd_run "$@" ;;
  screenshot) shift; cmd_screenshot "$@" ;;
  logs)       shift; cmd_logs "$@" ;;
  status)     shift; cmd_status "$@" ;;
  *) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
